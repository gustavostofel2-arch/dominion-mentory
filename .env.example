# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave SECRETA (service_role). Só no servidor. Nunca com NEXT_PUBLIC_ e nunca no GitHub.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Notificações push (opcional). Gere o par com:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=chave-publica-vapid
VAPID_PRIVATE_KEY=chave-privada-vapid-secreta
# VAPID_SUBJECT=mailto:contato@seudominio.com
